# Copy to .env and update values for your local PostgreSQL instance.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_receptionist?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Must be reachable by Synthflow (HTTPS public URL or tunnel). Used to build webhook URLs.
PUBLIC_API_URL="http://localhost:4000"

# Synthflow (Admin → Workspace Settings → API Keys / Security → Webhooks)
SYNTHFLOW_API_KEY=
SYNTHFLOW_WORKSPACE_ID=
SYNTHFLOW_WEBHOOK_SECRET=
SYNTHFLOW_API_BASE_URL="https://api.us.synthflow.ai/v2"
# Agent ID from the agent page (Qubetech AI Receptionist)
SYNTHFLOW_AGENT_ID=
SYNTHFLOW_PHONE_NUMBER="+12202205898"
# When true and AGENT_ID is set, boot will push webhook URLs to the agent
SYNTHFLOW_SYNC_WEBHOOKS="true"
