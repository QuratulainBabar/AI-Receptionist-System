# Copy to .env and update values for your local PostgreSQL instance.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_receptionist?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_URL="http://localhost:8081"
NODE_ENV="development"

# Must be reachable by Synthflow (HTTPS public URL or tunnel). Used to build webhook URLs.
PUBLIC_API_URL="http://localhost:4000"

# Synthflow (Admin → Workspace Settings → API Keys / Security → Webhooks)
SYNTHFLOW_API_KEY=
SYNTHFLOW_WORKSPACE_ID=
SYNTHFLOW_WEBHOOK_SECRET=
SYNTHFLOW_API_BASE_URL="https://api.us.synthflow.ai/v2"
# Agent ID from the agent page (Qubetech AI Receptionist)
SYNTHFLOW_AGENT_ID=
SYNTHFLOW_PHONE_NUMBER="+12202205898"
# When true and AGENT_ID is set, boot will push webhook URLs to the agent
SYNTHFLOW_SYNC_WEBHOOKS="true"

# Voice-booking OTP lifetime in seconds. The code expires this many seconds after it is generated.
# Texted during the call by the Synthflow in-call SMS action to the inbound caller (user_phone_number).
OTP_TTL_SECONDS=120

# Stripe (test mode). Super Admin → Subscriptions creates Products/Prices via the secret key.
# Webhook: POST {PUBLIC_API_URL}/api/webhooks/stripe
# Subscription events: checkout.session.completed, customer.subscription.*
# Appointment invoices: invoice.paid, invoice.payment_failed (metadata.kind = appointment_invoice)
# Local test: stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Clinic clock for doctor weekly hours, slot labels, and appointment reminder times.
# Must be a US IANA zone. Reminders are 3 days (same local time), 24 hours, and 6 hours before the visit.
CLINIC_TIMEZONE="America/Los_Angeles"
