# SPA fallback for CyberPanel / OpenLiteSpeed (frontend routes).
# /backend is handled by an OpenLiteSpeed proxy context (see .github/DEPLOY.md).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
